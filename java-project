pipeline {
    agent any

    stages {

        stage('Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/aniketkarhale07/java.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        
        stage('Deploy') {
            steps {
                sh '''
                    export JENKINS_NODE_COOKIE=dontkillme
        
                    /app/tomcat/bin/shutdown.sh || true
        
                    rm -rf /app/tomcat/webapps/webapp
                    rm -f /app/tomcat/webapps/webapp.war
        
                    cp -r target/webapp /app/tomcat/webapps/
                    cp target/webapp.war /app/tomcat/webapps/
        
                    /app/tomcat/bin/startup.sh
        
                    sleep 5
                '''
            }
        }
    }
}
